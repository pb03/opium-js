{
  "name": "opium-js",
  "productName": "opiumJS",
  "version": "1.3.0",
  "description": "MacOS utility for running JavaScript snippets",
  "main": "main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Prasanjit Singh",
  "license": "MIT",
  "build": {
    "productName": "opiumJS",
    "appId": "com.opiumjs.app",
    "icon": "assets/icons/512x512.png",
    "files": [
      "**/*",
      "!node_modules/monaco-editor/esm${/*}",
      "!node_modules/monaco-editor/dev${/*}",
      "!node_modules/monaco-editor/test${/*}",
      "!node_modules/**/test${/*}",
      "!node_modules/**/tests${/*}",
      "!node_modules/**/*.md",
      "!node_modules/**/.bin${/*}",
      "!**/*.ts",
      "!**/*.map"
    ],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "istanbul-lib-instrument": "^6.0.3",
    "monaco-editor": "^0.55.0"
  }
}
